{
  "manifest_version": 3,
  "name": "Math Copy \u2192 Notion",
  "version": "1.0.0",
  "description": "Copia respuestas de ChatGPT conservando el LaTeX exacto y convi\u00e9rtelas en bloques de f\u00f3rmula nativos de Notion (KaTeX).",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.notion.so/*",
    "https://notion.so/*",
    "https://*.notion.site/*",
    "https://app.notion.com/*",
    "https://*.notion.com/*",
    "https://*.notion.app/*",
    "https://www.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content-chatgpt-main.js"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1/*"],
      "js": ["content-chatgpt-boot.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1/*"],
      "js": ["content-chatgpt.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.notion.so/*",
        "https://notion.so/*",
        "https://*.notion.site/*",
        "https://app.notion.com/*",
        "https://*.notion.com/*",
        "https://*.notion.app/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-notion.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.google.com/*"],
      "js": ["content-google-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.google.com/*"],
      "js": ["content-google.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Math Copy \u2192 Notion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}